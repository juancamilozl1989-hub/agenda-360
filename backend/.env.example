# Copia este archivo como ".env" y completa tus valores.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=agenda360
DATABASE_USER=postgres
DATABASE_PASSWORD=tu_clave_de_postgres

# Clave para firmar los tokens JWT (usa una cadena larga y aleatoria)
SECRET_KEY=cambia_esta_clave
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Bot de WhatsApp (WhatsApp Cloud API de Meta). Son opcionales:
# sin ellas el sistema funciona, pero el bot no envía mensajes.
# Token de acceso y "Phone number ID": WhatsApp > Configuración de la API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Palabra secreta que tú inventas y escribes también al configurar el webhook en Meta
WHATSAPP_VERIFY_TOKEN=
# Clave secreta de la app (Configuración de la app > Básica); sirve para validar la firma
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
